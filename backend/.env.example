# Backend Configuration
APP_NAME="Multilingual News Intelligence"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Ingestion Constraints
MAX_TEXT_LENGTH_CHARS=100000
MAX_PDF_SIZE_BYTES=15728640
REQUEST_TIMEOUT_SECONDS=10
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=5242880

# Discovery Settings
GOOGLE_NEWS_ENABLED=true
GDELT_ENABLED=true
MAX_SEARCH_RESULTS_PER_LANG=6

# Optional LLM Configuration (fallback to rule/lexicon-based when disabled or not provided)
LLM_PROVIDER_ENABLED=false
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

