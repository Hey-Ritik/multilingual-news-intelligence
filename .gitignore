# ==============================================================================
# Git Ignore Configuration — Multilingual News Intelligence
# ==============================================================================

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Pytest & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# --- Node & Next.js ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & Secret Files (NEVER commit secrets) ---
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# --- IDEs & OS Metadata ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Generated PDF Exports & Scratches ---
*.pdf
scratch/

# --- Preserve Essential Project Assets ---
!docs/screenshots/*.png
