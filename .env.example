# ==============================================================================
# Multilingual News Intelligence System — Environment Variables Example
# ==============================================================================
# Copy this file to '.env' in your backend directory or set these variables
# in your hosting dashboard (e.g. Render, Vercel). NEVER commit real secrets.
# ==============================================================================

# --- Backend Application Configuration ---
APP_NAME="Multilingual News Intelligence"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Production CORS Allowed Origins ---
# Comma-separated list of allowed frontend domains. In production, specify your Vercel URL:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ingestion & Network Guardrails ---
MAX_TEXT_LENGTH_CHARS=100000
MAX_PDF_SIZE_BYTES=15728640
REQUEST_TIMEOUT_SECONDS=10
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=5242880

# --- Cross-Language Discovery Providers ---
GOOGLE_NEWS_ENABLED=true
GDELT_ENABLED=true
MAX_SEARCH_RESULTS_PER_LANG=6

# --- Supported Target Languages ---
# Comma-separated ISO-639-1 language codes (English, Hindi, Kannada, Telugu, Tamil)
SUPPORTED_LANGUAGES=en,hi,kn,te,ta

# --- Optional LLM Augmentation (Disabled by default; deterministic NLP is used) ---
LLM_PROVIDER_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# --- Frontend Configuration (Set in frontend/.env.local or Vercel dashboard) ---
# NEXT_PUBLIC_API_URL: Public base URL pointing to the FastAPI backend service
NEXT_PUBLIC_API_URL=http://localhost:8000

